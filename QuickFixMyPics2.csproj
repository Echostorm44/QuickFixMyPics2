<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QuickFixMyPics2</AssemblyName>
    <RootNamespace>QuickFixMyPics2</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- The exe / taskbar icon. -->
    <ApplicationIcon>Assets\appIcon.ico</ApplicationIcon>

    <!-- AOT is opt-in (-p:EnableAot=true), NOT unconditional in Release. The app SHIPS
         framework-dependent: the cascade installer packager publishes it with PublishAot=false,
         then builds it AGAIN as a ProjectReference from the AOT wizard. If this project forced
         PublishAot=true in Release, those two compiles into the same obj disagree on the AOT
         flavor and the SDK re-adds the generated AssemblyInfo to the compile list, a CS0579
         duplicate-attribute build break on CI. The code stays AOT-compatible (IsAotCompatible),
         so a standalone AOT exe is still: dotnet publish -c Release -p:EnableAot=true. -->
    <PublishAot Condition="'$(Configuration)' == 'Release' and '$(EnableAot)' == 'true'">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Consume Cascade.UI as a real external dev would: the published NuGet package,
         not the source. SharpImage + Etch (with native binaries) + the generator/analyzers
         + the .targets (DPI manifest, fonts) all flow in through the package. -->
    <PackageReference Include="Echostorm.Cascade.UI" Version="0.1.0-alpha.22" />
  </ItemGroup>

</Project>
