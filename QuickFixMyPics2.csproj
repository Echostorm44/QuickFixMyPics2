<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QuickFixMyPics2</AssemblyName>
    <RootNamespace>QuickFixMyPics2</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- The cascade installer packager stages generated helper projects (wizard, uninstaller,
         launcher, update shim) under a "<output>-build" scratch dir. When the output dir lives
         inside the repo (e.g. output "dist"), those projects' generated .cs (AssemblyInfo,
         Program.cs) fall under this app's default globbing and get double-compiled, a CS0579
         duplicate assembly-attributes break. Exclude the packager's output and scratch dirs so
         packaging works from the repo root on any machine or CI regardless of the output name. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);dist/**;dist-build/**</DefaultItemExcludes>

    <!-- The exe / taskbar icon. -->
    <ApplicationIcon>Assets\appIcon.ico</ApplicationIcon>

    <!-- Release is self-contained AOT. The cascade installer wizard (self-contained) references
         this project, and a self-contained exe cannot reference a non-self-contained one
         (NETSDK1150), so this must stay self-contained in Release. -->
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Consume Cascade.UI as a real external dev would: the published NuGet package,
         not the source. SharpImage + Etch (with native binaries) + the generator/analyzers
         + the .targets (DPI manifest, fonts) all flow in through the package. -->
    <PackageReference Include="Echostorm.Cascade.UI" Version="0.1.0-alpha.25" />
  </ItemGroup>

</Project>
